{"cues":[{"sectionId":"concept","start":0,"end":16.4},{"sectionId":"experiment","start":17.68,"end":36.16},{"sectionId":"checkpoint","start":37.56,"end":49.2}],"captions":[{"sectionId":"concept","start":0,"end":3.84,"text":"短句把可重用的音色和有順序的音符結合。"},{"sectionId":"concept","start":4.4,"end":6.16,"text":"固定包絡與波形，"},{"sectionId":"concept","start":6.32,"end":11.12,"text":"測試例如 220、330、440 Hz 的音高。"},{"sectionId":"concept","start":11.84,"end":13.12,"text":"保存音色設定，"},{"sectionId":"concept","start":13.44,"end":16.4,"text":"透過播放判斷音符之間的銜接。"},{"sectionId":"experiment","start":17.68,"end":19.44,"text":"選擇波形與柔和包絡，"},{"sectionId":"experiment","start":19.84,"end":21.92,"text":"使用旋律播放控制，"},{"sectionId":"experiment","start":22.08,"end":23.2,"text":"並保存樂器。"},{"sectionId":"experiment","start":24,"end":27.52,"text":"比較短釋音與長釋音的淡出長度；"},{"sectionId":"experiment","start":28.16,"end":32.24,"text":"旋律會在前一音釋音結束後才安排下一音。"},{"sectionId":"experiment","start":33.12,"end":34.64,"text":"比較兩組包絡時，"},{"sectionId":"experiment","start":34.72,"end":36.16,"text":"什麼應保持固定？"},{"sectionId":"checkpoint","start":37.56,"end":39.04,"text":"比較兩組包絡時，"},{"sectionId":"checkpoint","start":39.36,"end":41.04,"text":"什麼應保持固定？"},{"sectionId":"checkpoint","start":42.4,"end":46.08,"text":"請根據剛才測試的模型或程式選擇答案。"},{"sectionId":"checkpoint","start":46.56,"end":49.2,"text":"回饋會說明不同選項的差異。"}]}