{"cues":[{"sectionId":"concept","start":0,"end":16.08},{"sectionId":"experiment","start":17.28,"end":37.64},{"sectionId":"checkpoint","start":38.64,"end":49.84}],"captions":[{"sectionId":"concept","start":0,"end":2.72,"text":"循環應平順回到起始狀態。"},{"sectionId":"concept","start":3.44,"end":6.88,"text":"檢查週期邊界、頂點和接觸，"},{"sectionId":"concept","start":7.04,"end":9.36,"text":"不只看漂亮的中間影格。"},{"sectionId":"concept","start":10.16,"end":12.32,"text":"保存時間與變形參數，"},{"sectionId":"concept","start":12.8,"end":16.08,"text":"讓下次播放能重現相同鏡頭。"},{"sectionId":"experiment","start":17.28,"end":20,"text":"選擇高度、週期與擠壓量，"},{"sectionId":"experiment","start":20.56,"end":23.36,"text":"播放數個循環並檢查邊界，"},{"sectionId":"experiment","start":23.68,"end":27.2,"text":"再匯出作品資料以保留播放設定。"},{"sectionId":"experiment","start":28.32,"end":32.32,"text":"SVG 匯出只會記錄目前的靜止影格。"},{"sectionId":"experiment","start":34.32,"end":37.64,"text":"哪個檢查能發現循環接縫？"},{"sectionId":"checkpoint","start":38.64,"end":41.76,"text":"哪個檢查能發現循環接縫？"},{"sectionId":"checkpoint","start":42.32,"end":46.56,"text":"請根據剛才測試的模型或程式選擇答案。"},{"sectionId":"checkpoint","start":47.2,"end":49.84,"text":"回饋會說明不同選項的差異。"}]}