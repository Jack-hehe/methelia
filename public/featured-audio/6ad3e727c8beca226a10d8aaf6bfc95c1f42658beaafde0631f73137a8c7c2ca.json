{"cues":[{"sectionId":"concept","start":0,"end":17.84},{"sectionId":"experiment","start":18.44,"end":32.48},{"sectionId":"checkpoint","start":32.88,"end":44.64}],"captions":[{"sectionId":"concept","start":0,"end":4.96,"text":"Ohm's law gives I = V/R for an ideal resistor."},{"sectionId":"concept","start":5.307,"end":6.8,"text":"At fixed voltage,"},{"sectionId":"concept","start":7.251,"end":9.76,"text":"increasing resistance decreases current."},{"sectionId":"concept","start":10.251,"end":14.24,"text":"Always keep units visible: a current of 0."},{"sectionId":"concept","start":14.48,"end":17.84,"text":"03 amperes equals 30 milliamperes."},{"sectionId":"experiment","start":18.44,"end":23.12,"text":"Set 6 volts and compare resistance 100 and 200."},{"sectionId":"experiment","start":23.55,"end":28.08,"text":"Predict the factor by which current changes before inspecting the readout."},{"sectionId":"experiment","start":28.667,"end":31.2,"text":"At 6 V and 200 Ω,"},{"sectionId":"experiment","start":31.36,"end":32.48,"text":"what is the current?"},{"sectionId":"checkpoint","start":32.88,"end":35.36,"text":"At 6 V and 200 Ω,"},{"sectionId":"checkpoint","start":35.52,"end":36.72,"text":"what is the current?"},{"sectionId":"checkpoint","start":36.926,"end":40.72,"text":"Choose an answer using the model or program you just tested."},{"sectionId":"checkpoint","start":41.16,"end":44.64,"text":"The feedback will explain the difference between the alternatives."}]}