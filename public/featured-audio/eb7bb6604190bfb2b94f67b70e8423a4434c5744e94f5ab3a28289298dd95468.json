{"cues":[{"sectionId":"concept","start":0,"end":19.76},{"sectionId":"experiment","start":20.272,"end":38},{"sectionId":"checkpoint","start":38.64,"end":52}],"captions":[{"sectionId":"concept","start":0,"end":1.92,"text":"At height y = h,"},{"sectionId":"concept","start":2.26,"end":8.64,"text":"the sphere equation becomes x² + z² = r² − h²."},{"sectionId":"concept","start":9.34,"end":13.68,"text":"The slice radius is √(r² − h²)."},{"sectionId":"concept","start":14.36,"end":19.76,"text":"A negative value under the square root means that plane misses the sphere entirely."},{"sectionId":"experiment","start":20.272,"end":22,"text":"With radius 5,"},{"sectionId":"experiment","start":22.14,"end":23.999,"text":"compare slice heights 0,"},{"sectionId":"experiment","start":24.24,"end":25.28,"text":"3 and 5."},{"sectionId":"experiment","start":25.623,"end":27.36,"text":"Record a circle,"},{"sectionId":"experiment","start":27.8,"end":30.08,"text":"a smaller circle and the limiting point."},{"sectionId":"experiment","start":30.56,"end":33.28,"text":"Then test height −3."},{"sectionId":"experiment","start":33.84,"end":36.32,"text":"At radius 5 and height 3,"},{"sectionId":"experiment","start":36.608,"end":38,"text":"what is the slice radius?"},{"sectionId":"checkpoint","start":38.64,"end":41.36,"text":"At radius 5 and height 3,"},{"sectionId":"checkpoint","start":41.648,"end":43.04,"text":"what is the slice radius?"},{"sectionId":"checkpoint","start":43.463,"end":47.76,"text":"Choose an answer using the model or program you just tested."},{"sectionId":"checkpoint","start":48.18,"end":52,"text":"The feedback will explain the difference between the alternatives."}]}