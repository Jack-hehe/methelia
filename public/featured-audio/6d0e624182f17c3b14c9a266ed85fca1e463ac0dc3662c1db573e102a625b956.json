{"cues":[{"sectionId":"concept","start":0,"end":18},{"sectionId":"experiment","start":18.38,"end":35.12},{"sectionId":"checkpoint","start":35.984,"end":46.8}],"captions":[{"sectionId":"concept","start":0,"end":4.64,"text":"A shop cannot sell more cups than it has stock or willing customers."},{"sectionId":"concept","start":4.96,"end":11.92,"text":"This simulation uses an explicit demand response to price and baseline demand at $5."},{"sectionId":"concept","start":12.213,"end":14.24,"text":"It is a toy business model,"},{"sectionId":"concept","start":14.64,"end":18,"text":"not a forecast for a real cafe or investment decision."},{"sectionId":"experiment","start":18.38,"end":20.48,"text":"Inspect price 5,"},{"sectionId":"experiment","start":20.9,"end":25.28,"text":"stock 80 and baseline demand at $5 100."},{"sectionId":"experiment","start":25.91,"end":26.88,"text":"Compare demand,"},{"sectionId":"experiment","start":27.393,"end":28.88,"text":"sales and unsold stock;"},{"sectionId":"experiment","start":29.636,"end":32.24,"text":"identify which quantity limits sales."},{"sectionId":"experiment","start":32.544,"end":35.12,"text":"What limits actual sales?"},{"sectionId":"checkpoint","start":35.984,"end":38.24,"text":"What limits actual sales?"},{"sectionId":"checkpoint","start":38.571,"end":42.64,"text":"Choose an answer using the model or program you just tested."},{"sectionId":"checkpoint","start":43.14,"end":46.8,"text":"The feedback will explain the difference between the alternatives."}]}