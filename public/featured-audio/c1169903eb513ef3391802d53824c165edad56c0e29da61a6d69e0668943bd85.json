{"cues":[{"sectionId":"concept","start":0,"end":16.48},{"sectionId":"experiment","start":18.56,"end":32.88},{"sectionId":"checkpoint","start":34.12,"end":47.12}],"captions":[{"sectionId":"concept","start":0,"end":2.4,"text":"串聯電阻直接相加。"},{"sectionId":"concept","start":3.28,"end":4.96,"text":"相同電阻並聯時，"},{"sectionId":"concept","start":5.28,"end":8,"text":"多一條通路會降低等效電阻。"},{"sectionId":"concept","start":8.64,"end":11.68,"text":"因此即使每個分支電阻相同，"},{"sectionId":"concept","start":12.08,"end":16.48,"text":"同一個電源電壓也可能產生不同總電流。"},{"sectionId":"experiment","start":18.56,"end":20.24,"text":"固定電壓與電阻，"},{"sectionId":"experiment","start":20.64,"end":22.32,"text":"切換電路配置。"},{"sectionId":"experiment","start":23.36,"end":26.48,"text":"比較等效電阻和電源總電流，"},{"sectionId":"experiment","start":26.68,"end":27.84,"text":"不只看燈光。"},{"sectionId":"experiment","start":29.2,"end":32.88,"text":"多加一條相同電阻的並聯分支會怎樣？"},{"sectionId":"checkpoint","start":34.12,"end":38.32,"text":"多加一條相同電阻的並聯分支會怎樣？"},{"sectionId":"checkpoint","start":39.68,"end":43.6,"text":"請根據剛才測試的模型或程式選擇答案。"},{"sectionId":"checkpoint","start":44.32,"end":47.12,"text":"回饋會說明不同選項的差異。"}]}