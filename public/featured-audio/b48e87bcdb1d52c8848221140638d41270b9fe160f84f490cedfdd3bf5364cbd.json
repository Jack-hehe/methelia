{"cues":[{"sectionId":"concept","start":0,"end":16.56},{"sectionId":"experiment","start":16.848,"end":27.12},{"sectionId":"checkpoint","start":27.504,"end":37.44}],"captions":[{"sectionId":"concept","start":0,"end":5.2,"text":"Frame-by-frame animation creates perceived motion from successive poses."},{"sectionId":"concept","start":5.52,"end":8.32,"text":"Keyframes specify important states;"},{"sectionId":"concept","start":8.783,"end":10.72,"text":"interpolation fills the intervals."},{"sectionId":"concept","start":11.04,"end":14,"text":"Our bounce uses a ground pose and a high pose,"},{"sectionId":"concept","start":14.288,"end":16.56,"text":"with duration controlling the cycle's pace."},{"sectionId":"experiment","start":16.848,"end":18.32,"text":"Play the default bounce,"},{"sectionId":"experiment","start":18.613,"end":20.32,"text":"pause it and scrub the timeline."},{"sectionId":"experiment","start":20.516,"end":24.8,"text":"Identify the ground and highest poses before changing any timing."},{"sectionId":"experiment","start":25.04,"end":27.12,"text":"What does a keyframe specify?"},{"sectionId":"checkpoint","start":27.504,"end":29.2,"text":"What does a keyframe specify?"},{"sectionId":"checkpoint","start":29.486,"end":33.2,"text":"Choose an answer using the model or program you just tested."},{"sectionId":"checkpoint","start":33.58,"end":37.44,"text":"The feedback will explain the difference between the alternatives."}]}