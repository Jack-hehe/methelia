{"cues":[{"sectionId":"concept","start":0,"end":15.2},{"sectionId":"experiment","start":15.49,"end":30.96},{"sectionId":"checkpoint","start":31.248,"end":42.48}],"captions":[{"sectionId":"concept","start":0,"end":1.76,"text":"Screens combine emitted red,"},{"sectionId":"concept","start":2.053,"end":3.2,"text":"green and blue light."},{"sectionId":"concept","start":3.4,"end":5.2,"text":"Paint absorbs wavelengths,"},{"sectionId":"concept","start":5.493,"end":7.84,"text":"so mixing paint follows different rules."},{"sectionId":"concept","start":8.16,"end":12.88,"text":"Our RGB tool uses the screen model: zero channels produce black,"},{"sectionId":"concept","start":13.24,"end":15.2,"text":"and maximum channels produce white."},{"sectionId":"experiment","start":15.49,"end":17.12,"text":"Compare (0,"},{"sectionId":"experiment","start":17.44,"end":17.68,"text":"0,"},{"sectionId":"experiment","start":17.92,"end":18.16,"text":"0),"},{"sectionId":"experiment","start":18.56,"end":19.2,"text":"(255,"},{"sectionId":"experiment","start":19.52,"end":19.76,"text":"0,"},{"sectionId":"experiment","start":20,"end":21.6,"text":"0) and (255,"},{"sectionId":"experiment","start":21.84,"end":22.56,"text":"255,"},{"sectionId":"experiment","start":22.72,"end":23.52,"text":"255)."},{"sectionId":"experiment","start":23.749,"end":27.52,"text":"Notice that adding screen light brightens the result."},{"sectionId":"experiment","start":27.712,"end":29.44,"text":"What does maximum red,"},{"sectionId":"experiment","start":29.64,"end":30.96,"text":"green and blue produce?"},{"sectionId":"checkpoint","start":31.248,"end":33.04,"text":"What does maximum red,"},{"sectionId":"checkpoint","start":33.24,"end":34.48,"text":"green and blue produce?"},{"sectionId":"checkpoint","start":34.811,"end":38.88,"text":"Choose an answer using the model or program you just tested."},{"sectionId":"checkpoint","start":39.1,"end":42.48,"text":"The feedback will explain the difference between the alternatives."}]}