{"cues":[{"sectionId":"concept","start":0,"end":14.24},{"sectionId":"experiment","start":15.48,"end":35.6},{"sectionId":"checkpoint","start":37.2,"end":49.76}],"captions":[{"sectionId":"concept","start":0,"end":1.68,"text":"大字能吸引注意，"},{"sectionId":"concept","start":1.92,"end":4.08,"text":"但擁擠會讓閱讀困難。"},{"sectionId":"concept","start":4.48,"end":6.24,"text":"留白分隔群組，"},{"sectionId":"concept","start":6.36,"end":8.24,"text":"也給標題呼吸空間。"},{"sectionId":"concept","start":8.8,"end":11.6,"text":"應一起評估標題大小與間距，"},{"sectionId":"concept","start":11.84,"end":14.24,"text":"而不是把所有元素都放大。"},{"sectionId":"experiment","start":15.48,"end":16.96,"text":"提高標題字級，"},{"sectionId":"experiment","start":17.24,"end":20.56,"text":"再比較外側留白 20 和 40。"},{"sectionId":"experiment","start":21.2,"end":23.76,"text":"這個控制改變外側邊界，"},{"sectionId":"experiment","start":23.92,"end":24.88,"text":"不是行距。"},{"sectionId":"experiment","start":25.52,"end":27.6,"text":"檢查標題可用寬度，"},{"sectionId":"experiment","start":27.733,"end":30.48,"text":"以及它和固定網格區塊的距離。"},{"sectionId":"experiment","start":31.84,"end":35.6,"text":"標題周圍增加空間為何能改善層級？"},{"sectionId":"checkpoint","start":37.2,"end":41.28,"text":"標題周圍增加空間為何能改善層級？"},{"sectionId":"checkpoint","start":42.56,"end":46.48,"text":"請根據剛才測試的模型或程式選擇答案。"},{"sectionId":"checkpoint","start":47.04,"end":49.76,"text":"回饋會說明不同選項的差異。"}]}