{"cues":[{"sectionId":"concept","start":0,"end":18.4},{"sectionId":"experiment","start":18.61,"end":39.04},{"sectionId":"checkpoint","start":39.293,"end":53.2}],"captions":[{"sectionId":"concept","start":0,"end":6.4,"text":"Zero expected net value requires r = c/p when p is positive."},{"sectionId":"concept","start":6.84,"end":14.24,"text":"A rare large reward can be fair by this definition and still expose a player to long losing stretches."},{"sectionId":"concept","start":14.528,"end":18.4,"text":"Fair expectation does not mean low variability."},{"sectionId":"experiment","start":18.61,"end":20.88,"text":"Compare p = 0."},{"sectionId":"experiment","start":21.2,"end":21.52,"text":"5,"},{"sectionId":"experiment","start":21.8,"end":25.12,"text":"r = 2 with p = 0."},{"sectionId":"experiment","start":25.36,"end":25.76,"text":"1,"},{"sectionId":"experiment","start":26.08,"end":28.72,"text":"r = 10 at cost 1."},{"sectionId":"experiment","start":28.928,"end":31.04,"text":"Keep trials and seed fixed;"},{"sectionId":"experiment","start":31.44,"end":33.44,"text":"inspect how the outcomes spread."},{"sectionId":"experiment","start":33.68,"end":37.04,"text":"Which reward balances p = 0."},{"sectionId":"experiment","start":37.36,"end":39.04,"text":"2 and cost 1?"},{"sectionId":"checkpoint","start":39.293,"end":42.64,"text":"Which reward balances p = 0."},{"sectionId":"checkpoint","start":42.96,"end":44.72,"text":"2 and cost 1?"},{"sectionId":"checkpoint","start":44.96,"end":49.04,"text":"Choose an answer using the model or program you just tested."},{"sectionId":"checkpoint","start":49.36,"end":53.2,"text":"The feedback will explain the difference between the alternatives."}]}