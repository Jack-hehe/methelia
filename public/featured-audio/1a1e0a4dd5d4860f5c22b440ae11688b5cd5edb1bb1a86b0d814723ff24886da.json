{"cues":[{"sectionId":"concept","start":0,"end":17.44},{"sectionId":"experiment","start":18.4,"end":32.24},{"sectionId":"checkpoint","start":33.48,"end":45.84}],"captions":[{"sectionId":"concept","start":0,"end":1.44,"text":"選擇適中的電流，"},{"sectionId":"concept","start":1.84,"end":6,"text":"展示固定供電電壓時如何用電阻調整它。"},{"sectionId":"concept","start":6.8,"end":10.72,"text":"成果是一個有明確理想化假設的模擬電路。"},{"sectionId":"concept","start":11.36,"end":12.48,"text":"實體製作前，"},{"sectionId":"concept","start":12.8,"end":17.44,"text":"必須另外檢查元件額定值與真實 LED 行為。"},{"sectionId":"experiment","start":18.4,"end":19.84,"text":"保存一組 6 V 設定，"},{"sectionId":"experiment","start":20.24,"end":22.4,"text":"比較電阻 300 和 600，"},{"sectionId":"experiment","start":22.96,"end":27.04,"text":"記錄所選配置的等效電阻、電流與功率。"},{"sectionId":"experiment","start":27.96,"end":29.68,"text":"供電和拓撲固定時，"},{"sectionId":"experiment","start":30.16,"end":32.24,"text":"哪個調整能降低電流？"},{"sectionId":"checkpoint","start":33.48,"end":35.28,"text":"供電和拓撲固定時，"},{"sectionId":"checkpoint","start":35.68,"end":37.68,"text":"哪個調整能降低電流？"},{"sectionId":"checkpoint","start":38.88,"end":42.64,"text":"請根據剛才測試的模型或程式選擇答案。"},{"sectionId":"checkpoint","start":43.28,"end":45.84,"text":"回饋會說明不同選項的差異。"}]}