{"cues":[{"sectionId":"concept","start":0,"end":18.4},{"sectionId":"experiment","start":18.73,"end":34.24},{"sectionId":"checkpoint","start":34.7,"end":48.56}],"captions":[{"sectionId":"concept","start":0,"end":5.36,"text":"This track uses y = ax²/3 before the join adjustment,"},{"sectionId":"concept","start":5.76,"end":8.96,"text":"so its tangent slope is 2ax/3."},{"sectionId":"concept","start":9.215,"end":13.28,"text":"Increasing bend changes both the shape and its local direction."},{"sectionId":"concept","start":13.6,"end":18.4,"text":"We can therefore tune a track by specifying a desired slope at a chosen position."},{"sectionId":"experiment","start":18.73,"end":20.16,"text":"Compare bend 0."},{"sectionId":"experiment","start":20.48,"end":22.64,"text":"5 and 1 at x = 1."},{"sectionId":"experiment","start":23.135,"end":25.68,"text":"Predict how doubling bend affects the tangent,"},{"sectionId":"experiment","start":25.984,"end":27.6,"text":"then inspect the live readout."},{"sectionId":"experiment","start":27.92,"end":30.08,"text":"For this track with bend 0."},{"sectionId":"experiment","start":30.4,"end":31.68,"text":"5 and join 0,"},{"sectionId":"experiment","start":31.872,"end":34.24,"text":"what is the slope at x = 1?"},{"sectionId":"checkpoint","start":34.7,"end":36.8,"text":"For this track with bend 0."},{"sectionId":"checkpoint","start":37.12,"end":38.399,"text":"5 and join 0,"},{"sectionId":"checkpoint","start":38.512,"end":40.96,"text":"what is the slope at x = 1?"},{"sectionId":"checkpoint","start":41.314,"end":44.96,"text":"Choose an answer using the model or program you just tested."},{"sectionId":"checkpoint","start":45.3,"end":48.56,"text":"The feedback will explain the difference between the alternatives."}]}