{"cues":[{"sectionId":"concept","start":0,"end":15.4},{"sectionId":"build","start":16,"end":32.88},{"sectionId":"checkpoint","start":34.32,"end":44.48}],"captions":[{"sectionId":"concept","start":0,"end":3.36,"text":"響應式設計依可用視窗調整版面。"},{"sectionId":"concept","start":3.92,"end":8.96,"text":"文件中的 viewport 標籤讓手機瀏覽器使用裝置寬度。"},{"sectionId":"concept","start":9.68,"end":12.56,"text":"媒體查詢能在雙欄過窄之前，"},{"sectionId":"concept","start":12.76,"end":15.4,"text":"把作品網格改回單欄。"},{"sectionId":"build","start":16,"end":16.96,"text":"把 /responsive."},{"sectionId":"build","start":17.18,"end":21.6,"text":"css 的斷點從 200px 改成 600px。"},{"sectionId":"build","start":22.72,"end":27.84,"text":"比較寬與窄的預覽：手機上的作品應上下排列，"},{"sectionId":"build","start":28.027,"end":29.92,"text":"而且不需要左右捲動。"},{"sectionId":"build","start":30.72,"end":32.88,"text":"實用的斷點應由什麼決定？"},{"sectionId":"checkpoint","start":34.32,"end":36.48,"text":"實用的斷點應由什麼決定？"},{"sectionId":"checkpoint","start":37.2,"end":41.12,"text":"請根據剛才測試的模型或程式選擇答案。"},{"sectionId":"checkpoint","start":41.76,"end":44.48,"text":"回饋會說明不同選項的差異。"}]}