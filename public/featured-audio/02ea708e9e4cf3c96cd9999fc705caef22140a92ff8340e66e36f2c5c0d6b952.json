{"cues":[{"sectionId":"concept","start":0,"end":14.24},{"sectionId":"experiment","start":15.2,"end":37.28},{"sectionId":"checkpoint","start":38.64,"end":49.84}],"captions":[{"sectionId":"concept","start":0,"end":3.76,"text":"報告哪些成分被留下、通過或變成蒸氣。"},{"sectionId":"concept","start":4.4,"end":7.2,"text":"粒子圖解展示理想的完全分離；"},{"sectionId":"concept","start":7.68,"end":9.76,"text":"真實純度仍需要測量。"},{"sectionId":"concept","start":10.4,"end":14.24,"text":"重設能讓不同計畫從相同混合物開始比較。"},{"sectionId":"experiment","start":15.2,"end":17.12,"text":"先關閉兩個處理開關，"},{"sectionId":"experiment","start":17.44,"end":19.56,"text":"再啟用過濾與蒸發。"},{"sectionId":"experiment","start":19.68,"end":24.96,"text":"確認分開的收集皿各有 8 個砂粒、12 個鹽粒，"},{"sectionId":"experiment","start":25.44,"end":27.68,"text":"且 40 個水粒已蒸發。"},{"sectionId":"experiment","start":28.56,"end":30.16,"text":"匯出最後作品資料，"},{"sectionId":"experiment","start":30.64,"end":33.2,"text":"說明為何沒有回收液態水。"},{"sectionId":"experiment","start":34.4,"end":37.28,"text":"什麼證據支持模型中的分離結果？"},{"sectionId":"checkpoint","start":38.64,"end":41.76,"text":"什麼證據支持模型中的分離結果？"},{"sectionId":"checkpoint","start":42.96,"end":46.8,"text":"請根據剛才測試的模型或程式選擇答案。"},{"sectionId":"checkpoint","start":47.28,"end":49.84,"text":"回饋會說明不同選項的差異。"}]}