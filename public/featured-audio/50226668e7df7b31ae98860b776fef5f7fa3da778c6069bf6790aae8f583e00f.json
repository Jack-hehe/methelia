{"cues":[{"sectionId":"concept","start":0,"end":16.72},{"sectionId":"experiment","start":17.44,"end":31.2},{"sectionId":"checkpoint","start":32.44,"end":43.2}],"captions":[{"sectionId":"concept","start":0,"end":7.6,"text":"座標幾何把代數和圖形接起來：點的位置用相對於固定座標軸的兩個數字表示。"},{"sectionId":"concept","start":8.16,"end":11.44,"text":"探索器先從以原點為中心的圓開始。"},{"sectionId":"concept","start":12,"end":13.36,"text":"座標描述位置，"},{"sectionId":"concept","start":13.76,"end":16.72,"text":"半徑則決定哪些位置屬於邊界。"},{"sectionId":"experiment","start":17.44,"end":18.8,"text":"把半徑設為 3，"},{"sectionId":"experiment","start":19.12,"end":23.04,"text":"用圓的方程式預測水平軸上的兩個交點。"},{"sectionId":"experiment","start":23.68,"end":24.64,"text":"增加到 4，"},{"sectionId":"experiment","start":25.04,"end":26.48,"text":"先預測新位置，"},{"sectionId":"experiment","start":26.6,"end":27.68,"text":"再檢查圖形。"},{"sectionId":"experiment","start":28.4,"end":29.44,"text":"半徑為 4 時，"},{"sectionId":"experiment","start":29.6,"end":31.2,"text":"右側交點在哪裡？"},{"sectionId":"checkpoint","start":32.44,"end":33.76,"text":"半徑為 4 時，"},{"sectionId":"checkpoint","start":34.16,"end":35.6,"text":"右側交點在哪裡？"},{"sectionId":"checkpoint","start":36.64,"end":40.16,"text":"請根據剛才測試的模型或程式選擇答案。"},{"sectionId":"checkpoint","start":40.8,"end":43.2,"text":"回饋會說明不同選項的差異。"}]}