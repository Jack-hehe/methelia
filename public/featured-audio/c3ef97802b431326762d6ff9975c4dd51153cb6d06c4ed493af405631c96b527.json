{"cues":[{"sectionId":"concept","start":0,"end":15.84},{"sectionId":"experiment","start":16.22,"end":32.64},{"sectionId":"checkpoint","start":32.893,"end":44.56}],"captions":[{"sectionId":"concept","start":0,"end":2.72,"text":"Two full-strength channels create cyan,"},{"sectionId":"concept","start":2.94,"end":4.16,"text":"magenta or yellow."},{"sectionId":"concept","start":4.92,"end":6.8,"text":"These are combinations of light,"},{"sectionId":"concept","start":7.26,"end":9.599,"text":"not additional independent channels."},{"sectionId":"concept","start":9.867,"end":12.08,"text":"By holding one channel at zero,"},{"sectionId":"concept","start":12.44,"end":15.84,"text":"you can explore a whole face of the RGB color cube."},{"sectionId":"experiment","start":16.22,"end":19.44,"text":"Set red and green to 255,"},{"sectionId":"experiment","start":19.824,"end":20.8,"text":"blue to 0."},{"sectionId":"experiment","start":21.056,"end":24.16,"text":"Then lower green to 128."},{"sectionId":"experiment","start":24.56,"end":27.92,"text":"Observe the shift from yellow toward orange."},{"sectionId":"experiment","start":28.333,"end":32.64,"text":"Which channels make yellow in additive RGB?"},{"sectionId":"checkpoint","start":32.893,"end":36.56,"text":"Which channels make yellow in additive RGB?"},{"sectionId":"checkpoint","start":36.857,"end":40.88,"text":"Choose an answer using the model or program you just tested."},{"sectionId":"checkpoint","start":41.14,"end":44.56,"text":"The feedback will explain the difference between the alternatives."}]}