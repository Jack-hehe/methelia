{"cues":[{"sectionId":"concept","start":0,"end":12.56},{"sectionId":"experiment","start":14,"end":29.6},{"sectionId":"checkpoint","start":30.88,"end":42.16}],"captions":[{"sectionId":"concept","start":0,"end":2,"text":"能接住一次暴雨的設計，"},{"sectionId":"concept","start":2.08,"end":4.48,"text":"遇到更大雨量仍可能溢流。"},{"sectionId":"concept","start":5.04,"end":6.48,"text":"保留土地配置，"},{"sectionId":"concept","start":6.64,"end":7.68,"text":"比較多種雨量。"},{"sectionId":"concept","start":8.24,"end":10.88,"text":"逕流非負和總水量有交代，"},{"sectionId":"concept","start":11,"end":12.56,"text":"是模擬的基本檢查。"},{"sectionId":"experiment","start":14,"end":16.24,"text":"固定綠地 50、蓄水 25，"},{"sectionId":"experiment","start":16.64,"end":19.6,"text":"比較雨量 40、80、120，"},{"sectionId":"experiment","start":20.24,"end":22.24,"text":"注意逕流何時出現，"},{"sectionId":"experiment","start":22.373,"end":24.24,"text":"以及哪個容量成為限制。"},{"sectionId":"experiment","start":26.16,"end":27.84,"text":"一次模擬沒有逕流，"},{"sectionId":"experiment","start":27.96,"end":29.6,"text":"就證明不會淹水嗎？"},{"sectionId":"checkpoint","start":30.88,"end":32.4,"text":"一次模擬沒有逕流，"},{"sectionId":"checkpoint","start":32.64,"end":34.32,"text":"就證明不會淹水嗎？"},{"sectionId":"checkpoint","start":35.68,"end":39.2,"text":"請根據剛才測試的模型或程式選擇答案。"},{"sectionId":"checkpoint","start":39.68,"end":42.16,"text":"回饋會說明不同選項的差異。"}]}