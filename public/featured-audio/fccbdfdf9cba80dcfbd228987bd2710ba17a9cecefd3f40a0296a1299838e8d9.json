{"cues":[{"sectionId":"concept","start":0,"end":15.2},{"sectionId":"experiment","start":16.4,"end":31.36},{"sectionId":"checkpoint","start":33.12,"end":46.48}],"captions":[{"sectionId":"concept","start":0,"end":4.32,"text":"兩個全亮通道可產生青、洋紅或黃。"},{"sectionId":"concept","start":4.96,"end":6.32,"text":"它們是光的組合，"},{"sectionId":"concept","start":6.6,"end":8.88,"text":"不是新增的獨立通道。"},{"sectionId":"concept","start":9.68,"end":11.6,"text":"把一個通道固定為零，"},{"sectionId":"concept","start":11.88,"end":15.2,"text":"就能探索 RGB 色立方的一個面。"},{"sectionId":"experiment","start":16.4,"end":19.84,"text":"把紅綠設為 255、藍設為 0，"},{"sectionId":"experiment","start":20.2,"end":22.48,"text":"再把綠降到 128，"},{"sectionId":"experiment","start":23.12,"end":26,"text":"觀察黃色如何偏向橘色。"},{"sectionId":"experiment","start":27.28,"end":28.64,"text":"RGB 加色中，"},{"sectionId":"experiment","start":29.12,"end":31.36,"text":"哪兩個通道組成黃色？"},{"sectionId":"checkpoint","start":33.12,"end":34.56,"text":"RGB 加色中，"},{"sectionId":"checkpoint","start":35.04,"end":37.28,"text":"哪兩個通道組成黃色？"},{"sectionId":"checkpoint","start":38.72,"end":42.96,"text":"請根據剛才測試的模型或程式選擇答案。"},{"sectionId":"checkpoint","start":43.76,"end":46.48,"text":"回饋會說明不同選項的差異。"}]}