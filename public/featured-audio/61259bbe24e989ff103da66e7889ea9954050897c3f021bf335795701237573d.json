{"cues":[{"sectionId":"concept","start":0,"end":15.6},{"sectionId":"experiment","start":16.2,"end":30.48},{"sectionId":"checkpoint","start":32.08,"end":42.72}],"captions":[{"sectionId":"concept","start":0,"end":3.44,"text":"恢復係數比較分離速度與接近速度。"},{"sectionId":"concept","start":3.6,"end":4.68,"text":"係數為零時，"},{"sectionId":"concept","start":4.88,"end":7.44,"text":"兩個物體有相同的碰後速度。"},{"sectionId":"concept","start":7.92,"end":9.68,"text":"動量仍然平衡，"},{"sectionId":"concept","start":9.92,"end":12.88,"text":"但部分動能轉成形變或熱，"},{"sectionId":"concept","start":13.16,"end":15.6,"text":"這個簡化模型沒有直接畫出。"},{"sectionId":"experiment","start":16.2,"end":18.16,"text":"保持入射條件不變，"},{"sectionId":"experiment","start":18.44,"end":22.16,"text":"把相同質量的碰撞改為恢復係數 0。"},{"sectionId":"experiment","start":22.88,"end":26.08,"text":"比較碰後速度與彈性案例的動能。"},{"sectionId":"experiment","start":27.52,"end":30.48,"text":"隔離的非彈性碰撞仍守恆什麼？"},{"sectionId":"checkpoint","start":32.08,"end":35.2,"text":"隔離的非彈性碰撞仍守恆什麼？"},{"sectionId":"checkpoint","start":36.24,"end":39.84,"text":"請根據剛才測試的模型或程式選擇答案。"},{"sectionId":"checkpoint","start":40.32,"end":42.72,"text":"回饋會說明不同選項的差異。"}]}