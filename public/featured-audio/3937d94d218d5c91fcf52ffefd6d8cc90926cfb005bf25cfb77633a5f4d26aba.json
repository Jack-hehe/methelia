{"cues":[{"sectionId":"concept","start":0,"end":15.12},{"sectionId":"experiment","start":16.16,"end":26.56},{"sectionId":"checkpoint","start":28.72,"end":38.64}],"captions":[{"sectionId":"concept","start":0,"end":3.84,"text":"生態模型把食物網簡化成可測量關係。"},{"sectionId":"concept","start":4.48,"end":7.12,"text":"這裡獵物依靠資源成長，"},{"sectionId":"concept","start":7.24,"end":8.72,"text":"捕食者依賴獵物。"},{"sectionId":"concept","start":9.44,"end":11.44,"text":"變數代表整體族群，"},{"sectionId":"concept","start":11.52,"end":12.56,"text":"不是個別生物，"},{"sectionId":"concept","start":12.84,"end":15.12,"text":"也不是特定棲地的預測。"},{"sectionId":"experiment","start":16.16,"end":17.52,"text":"執行初始族群，"},{"sectionId":"experiment","start":17.84,"end":19.28,"text":"辨認兩條曲線。"},{"sectionId":"experiment","start":20,"end":22.16,"text":"觀察一個族群變化後，"},{"sectionId":"experiment","start":22.48,"end":24,"text":"另一個如何回應。"},{"sectionId":"experiment","start":25.12,"end":26.56,"text":"這個模型代表什麼？"},{"sectionId":"checkpoint","start":28.72,"end":30.32,"text":"這個模型代表什麼？"},{"sectionId":"checkpoint","start":31.52,"end":35.28,"text":"請根據剛才測試的模型或程式選擇答案。"},{"sectionId":"checkpoint","start":35.92,"end":38.64,"text":"回饋會說明不同選項的差異。"}]}