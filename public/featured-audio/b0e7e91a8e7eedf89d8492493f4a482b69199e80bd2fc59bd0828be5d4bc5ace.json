{"cues":[{"sectionId":"concept","start":0,"end":14.72},{"sectionId":"experiment","start":15.1,"end":33.36},{"sectionId":"checkpoint","start":33.68,"end":47.12}],"captions":[{"sectionId":"concept","start":0,"end":3.52,"text":"The final condition combines authorization with NOT C."},{"sectionId":"concept","start":3.728,"end":5.12,"text":"When the alarm is on,"},{"sectionId":"concept","start":5.44,"end":9.84,"text":"NOT C is false and the door stays closed regardless of A or B."},{"sectionId":"concept","start":10.107,"end":14.72,"text":"Parenthesizing the authorization expression makes this veto explicit."},{"sectionId":"experiment","start":15.1,"end":17.36,"text":"Set both authorizations true,"},{"sectionId":"experiment","start":17.744,"end":18.96,"text":"then toggle alarm."},{"sectionId":"experiment","start":19.2,"end":24.32,"text":"Repeat with OR selected and only one authorization true;"},{"sectionId":"experiment","start":24.549,"end":27.2,"text":"verify the alarm still blocks entry."},{"sectionId":"experiment","start":27.6,"end":30.72,"text":"For (A OR B) AND NOT C,"},{"sectionId":"experiment","start":30.992,"end":33.36,"text":"what does C = 1 force?"},{"sectionId":"checkpoint","start":33.68,"end":36.64,"text":"For (A OR B) AND NOT C,"},{"sectionId":"checkpoint","start":36.848,"end":39.44,"text":"what does C = 1 force?"},{"sectionId":"checkpoint","start":39.737,"end":43.52,"text":"Choose an answer using the model or program you just tested."},{"sectionId":"checkpoint","start":43.78,"end":47.12,"text":"The feedback will explain the difference between the alternatives."}]}