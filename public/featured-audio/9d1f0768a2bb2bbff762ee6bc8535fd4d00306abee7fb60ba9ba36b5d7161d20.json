{"cues":[{"sectionId":"concept","start":0,"end":15.12},{"sectionId":"experiment","start":16.16,"end":29.36},{"sectionId":"checkpoint","start":31.36,"end":42.08}],"captions":[{"sectionId":"concept","start":0,"end":3.36,"text":"綠地和蓄水都使用土地或施工資源。"},{"sectionId":"concept","start":3.92,"end":7.12,"text":"呈現兩組配置在同一場暴雨下的逕流，"},{"sectionId":"concept","start":7.44,"end":10.4,"text":"再說明模擬沒有計價的取捨。"},{"sectionId":"concept","start":10.88,"end":13.36,"text":"最後計畫是學習作品，"},{"sectionId":"concept","start":13.44,"end":15.12,"text":"不是現地工程建議。"},{"sectionId":"experiment","start":16.16,"end":17.6,"text":"保存所選配置，"},{"sectionId":"experiment","start":17.68,"end":19.76,"text":"與較低蓄水替代方案比較。"},{"sectionId":"experiment","start":20.48,"end":23.2,"text":"記錄降雨假設和一個省略因素，"},{"sectionId":"experiment","start":23.52,"end":25.2,"text":"例如土壤飽和。"},{"sectionId":"experiment","start":27.28,"end":29.36,"text":"哪種報告能讓比較重現？"},{"sectionId":"checkpoint","start":31.36,"end":33.6,"text":"哪種報告能讓比較重現？"},{"sectionId":"checkpoint","start":35.2,"end":38.96,"text":"請根據剛才測試的模型或程式選擇答案。"},{"sectionId":"checkpoint","start":39.6,"end":42.08,"text":"回饋會說明不同選項的差異。"}]}