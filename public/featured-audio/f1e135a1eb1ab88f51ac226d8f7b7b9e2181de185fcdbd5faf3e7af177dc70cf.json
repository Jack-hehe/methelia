{"cues":[{"sectionId":"concept","start":0,"end":17.28},{"sectionId":"experiment","start":18.32,"end":32.96},{"sectionId":"checkpoint","start":34.224,"end":46.28}],"captions":[{"sectionId":"concept","start":0,"end":2.16,"text":"電功率為 P = VI，"},{"sectionId":"concept","start":2.64,"end":5.76,"text":"對電阻也可寫成 V²/R。"},{"sectionId":"concept","start":6.56,"end":9.12,"text":"電阻固定、電壓加倍時，"},{"sectionId":"concept","start":9.36,"end":10.56,"text":"功率變四倍。"},{"sectionId":"concept","start":11.44,"end":14.16,"text":"畫面亮度只是耗能的教學指標，"},{"sectionId":"concept","start":14.4,"end":17.28,"text":"不是真實燈具亮度的校準預測。"},{"sectionId":"experiment","start":18.32,"end":20.32,"text":"保持電阻與配置相同，"},{"sectionId":"experiment","start":20.72,"end":22.64,"text":"比較 3 和 6 伏特。"},{"sectionId":"experiment","start":23.52,"end":25.92,"text":"同時追蹤功率與電流，"},{"sectionId":"experiment","start":26.32,"end":28.56,"text":"辨認它們不同的倍率變化。"},{"sectionId":"experiment","start":29.76,"end":31.04,"text":"電壓加倍時，"},{"sectionId":"experiment","start":31.28,"end":32.96,"text":"功率為何變四倍？"},{"sectionId":"checkpoint","start":34.224,"end":35.6,"text":"電壓加倍時，"},{"sectionId":"checkpoint","start":35.92,"end":37.76,"text":"功率為何變四倍？"},{"sectionId":"checkpoint","start":39.04,"end":43.68,"text":"請根據剛才測試的模型或程式選擇答案。"},{"sectionId":"checkpoint","start":43.84,"end":46.28,"text":"回饋會說明不同選項的差異。"}]}