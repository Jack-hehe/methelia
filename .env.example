# Copy to .env.local and fill values locally. Never commit credentials.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# METHELIA_DATA_DIR=.data

# Optional locally; Render's Blueprint configures these securely.
# METHELIA_DEMO_PASSWORD= (username: demo; at least 16 characters on Render)
# METHELIA_ALLOWED_ORIGINS=https://methelia.com,https://www.methelia.com
METHELIA_AI_DAILY_REQUESTS=unlimited
METHELIA_SPEECH_DAILY_CHARACTERS=unlimited
# unlimited removes application daily caps; usage is still counted and billed by providers.
# Limits are global per UTC day. Zero blocks new requests, not unlimited usage.
